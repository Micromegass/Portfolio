---
import Base from '@/layouts/Base.astro';
import { href } from '@/lib/i18n';
import { t } from '@/data';

const locale = 'en';
const nf = t(locale).notFound;
---

<Base locale={locale} page="home">
  <section class="wrap nf">
    <span class="eyebrow">404</span>
    <h1 class="nf__title">{nf.title}</h1>
    <p class="lead nf__body">{nf.body}</p>
    <p><a class="button button--primary" href={href('home', locale)}>{nf.link} →</a></p>
  </section>
</Base>

<style>
  .nf {
    padding-top: var(--space-7);
    min-height: 55vh;
    text-align: center;
  }

  .nf__title {
    margin: var(--space-2) auto var(--space-4);
  }

  .nf__body {
    margin-inline: auto;
    max-width: 30rem;
  }
</style>
