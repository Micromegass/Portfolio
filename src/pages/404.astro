---
import Base from '@/layouts/Base.astro';
import { href } from '@/lib/i18n';
import { t } from '@/data';

const locale = 'en';
const nf = t(locale).notFound;
---

<Base locale={locale} page="home">
  <section class="nf" data-tone="dark">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1 class="nf__title">{nf.title}</h1>
      <p class="lead nf__body">{nf.body}</p>
      <a class="button button--primary" href={href('home', locale)}>{nf.link} <span>→</span></a>
    </div>
  </section>
</Base>

<style>
  .nf {
    background: var(--ink);
    padding: var(--space-8) 0;
    min-height: 60vh;
    text-align: center;
  }

  .nf__title {
    max-width: 18ch;
    margin: 0 auto var(--space-4);
  }

  .nf__body {
    margin: 0 auto var(--space-5);
  }
</style>
