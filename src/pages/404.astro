---
import Base from '@/layouts/Base.astro';
import { href } from '@/lib/i18n';
import { t } from '@/data';

const locale = 'en';
const nf = t(locale).notFound;
---

<Base locale={locale} page="home" sheet="—">
  <section class="sheet nf">
    <span class="anno anno--mark">ERROR 404</span>
    <h1 class="nf__title">{nf.title}</h1>
    <p class="lead nf__body">{nf.body}</p>
    <p><a href={href('home', locale)}>{nf.link} →</a></p>
  </section>
</Base>

<style>
  .nf {
    padding-top: var(--space-7);
    min-height: 55vh;
  }

  .nf__title {
    margin-top: var(--space-3);
  }

  .nf__body {
    color: var(--ink-soft);
  }
</style>
