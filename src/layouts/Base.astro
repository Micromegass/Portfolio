---
import '@fontsource-variable/hanken-grotesk/index.css';
import '@/styles/global.css';

import type { Locale, PageKey } from '@/lib/i18n';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ChatWidget from '@/components/ChatWidget.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
/* Mirrors ChatWidget's own condition: the assistant is only built when a
   backend exists, and the WhatsApp button must sit clear of it when it is. */
const hasAssistant = Boolean(import.meta.env.PUBLIC_CHAT_ENDPOINT);
const skipLabel = { en: 'Skip to content', de: 'Zum Inhalt springen', es: 'Saltar al contenido' }[
  locale
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Apply the stored theme before first paint so there is no flash.
      // No stored choice means the OS preference wins, handled in CSS.
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored;
      } catch (e) {}
    </script>
    <Seo locale={locale} page={page} />
  </head>
  <body>
    <script is:inline>
      // Arm scroll reveals before first paint so nothing flashes, but drop the
      // class if the motion bundle never initialises — content must never be
      // trapped behind JavaScript.
      (function () {
        var d = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        setTimeout(function () {
          if (!d.dataset.motionReady) d.classList.remove('motion');
        }, 3500);
      })();
    </script>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Header locale={locale} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <ChatWidget locale={locale} />
    {/* Not on the contact page: WhatsApp and email are already inline there,
        and a floating copy only covers them. */}
    {page !== 'contact' && <WhatsAppButton locale={locale} raised={hasAssistant} />}
    <script>
      import { initMotion } from '@/scripts/motion';
      initMotion();
    </script>
  </body>
</html>
