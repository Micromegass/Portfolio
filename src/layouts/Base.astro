---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@/styles/global.css';

import type { Locale, PageKey } from '@/lib/i18n';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  locale: Locale;
  page: PageKey;
  /** Sheet number in the footer title block */
  sheet?: string;
}

const { locale, page, sheet = '01' } = Astro.props;
const skipLabel = { en: 'Skip to content', de: 'Zum Inhalt springen', es: 'Saltar al contenido' }[
  locale
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <Seo locale={locale} page={page} />
  </head>
  <body>
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('js');
    </script>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Header locale={locale} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} page={page} sheet={sheet} />
    <script>
      import { initMotion } from '@/scripts/motion';
      initMotion();
    </script>
  </body>
</html>
