---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaBand from '@/components/CtaBand.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale).services;
---

<Base locale={locale} page="services">
  <section class="wrap intro">
    <span class="eyebrow" data-reveal>{s.kicker}</span>
    <h1 class="intro__title" data-reveal>{s.title}</h1>
    <p class="lead intro__lead" data-reveal>{s.intro}</p>
  </section>

  <section class="wrap services" data-reveal-group>
    {
      s.items.map((item) => (
        <article class="service" id={item.id}>
          <div class="service__main">
            <h2 class="service__title">{item.title}</h2>
            <p class="service__desc">{item.desc}</p>
          </div>
          <div class="service__side">
            <span class="service__side-label">{s.deliverablesLabel}</span>
            <ul class="service__list">
              {item.deliverables.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </section>

  <section class="wrap process">
    <SectionHead centered kicker={s.process.kicker} title={s.process.title} />
    <p class="lead process__intro" data-reveal>{s.process.intro}</p>
    <ol class="process__steps" data-reveal-group>
      {
        s.process.steps.map((step, i) => (
          <li class="step">
            <span class="step__num">{i + 1}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    padding-top: var(--space-6);
  }

  .intro__title {
    max-width: 22ch;
    margin-top: var(--space-2);
  }

  .intro__lead {
    max-width: 38rem;
  }

  .services {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .service {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-5);
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-soft);
  }

  .service__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .service__desc {
    color: var(--text-soft);
    margin: 0;
  }

  .service__side-label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .service__list {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .service__list li {
    padding: var(--space-2) 0 var(--space-2) 1.4em;
    position: relative;
  }

  .service__list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .process {
    margin-top: var(--space-8);
  }

  .process__intro {
    text-align: center;
    margin: calc(-1 * var(--space-3)) auto var(--space-5);
  }

  .process__steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .step {
    background: var(--bg-soft);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .step__num {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
  }

  .step__title {
    font-size: var(--text-md);
    margin: var(--space-3) 0 var(--space-2);
  }

  .step__body {
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 900px) {
    .service {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .process__steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .process__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
