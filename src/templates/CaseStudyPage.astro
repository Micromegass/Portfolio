---
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/CtaBand.astro';
import { href, type Locale, type PageKey } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  caseKey: 'physio' | 'ikuna';
}

const { locale, caseKey } = Astro.props;
const c = t(locale).cases[caseKey];
const m = t(locale).caseMeta;
const w = t(locale).work;

const page: PageKey = caseKey === 'physio' ? 'case-physio' : 'case-ikuna';
const nextKey = caseKey === 'physio' ? 'ikuna' : 'physio';
const nextPage: PageKey = nextKey === 'physio' ? 'case-physio' : 'case-ikuna';
---

<Base locale={locale} page={page}>
  <article>
    <section class="intro" data-tone="dark">
      <div class="wrap" data-hero-seq>
        <a class="back" href={href('work', locale)}>← {m.backLabel}</a>
        <span class="eyebrow">{m.eyebrow} · {c.sector}</span>
        <h1 class="intro__title">{c.title}</h1>
        <p class="lead intro__lead">{c.summary}</p>
        <div class="intro__actions">
          <a class="button button--primary" href={c.url} target="_blank" rel="noopener"
            >{w.visitLabel} <span>↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="band band--curve" data-tone="light">
      <div class="wrap">
        <div class="glance card" data-reveal>
          <h2 class="glance__head">{m.specLabel}</h2>
          <dl class="glance__grid">
            {
              c.specs.map((s) => (
                <div>
                  <dt class="glance__label">{s.label}</dt>
                  <dd class="glance__value">{s.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="body">
          {
            c.sections.map((s) => (
              <section class="body__section" data-reveal>
                <h2 class="body__heading">{s.heading}</h2>
                <p class="body__text">{s.body}</p>
              </section>
            ))
          }
        </div>

        <section class="outcomes" data-reveal>
          <h2 class="outcomes__head">{c.outcomeLabel}</h2>
          <ul class="outcomes__list">
            {c.outcomes.map((o) => <li>{o}</li>)}
          </ul>
        </section>

        <p class="next" data-reveal>
          <a class="arrow-link" href={href(nextPage, locale)}
            >{m.nextLabel}: {t(locale).cases[nextKey].client} <span>→</span></a
          >
        </p>
      </div>
    </section>
  </article>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    background: var(--ink);
    position: relative;
    overflow: hidden;
    padding: var(--space-5) 0 var(--space-8);
  }

  .intro::before {
    content: '';
    position: absolute;
    width: 52rem;
    height: 52rem;
    top: -30rem;
    right: -16rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 62%);
    pointer-events: none;
  }

  .intro .wrap {
    position: relative;
  }

  .back {
    display: inline-block;
    color: var(--on-ink-mute);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .back:hover {
    color: var(--on-ink);
  }

  .intro__title {
    max-width: 18ch;
    margin: 0 0 var(--space-4);
  }

  .intro__lead {
    max-width: 42rem;
  }

  .intro__actions {
    margin-top: var(--space-5);
  }

  .glance {
    padding: var(--space-4) var(--space-5);
  }

  .glance__head {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
    font-family: var(--font-body);
    margin: 0 0 var(--space-3);
  }

  .glance__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin: 0;
  }

  .glance__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }

  .glance__value {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  .body {
    margin-top: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .body__heading {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
    max-width: 24ch;
  }

  .body__text {
    color: var(--fg-mute);
    font-size: var(--text-md);
    line-height: 1.7;
    margin: 0;
  }

  .outcomes {
    margin-top: var(--space-7);
    background: var(--ink);
    color: var(--on-ink);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .outcomes__head {
    font-size: var(--text-md);
    margin: 0 0 var(--space-3);
  }

  .outcomes__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 44rem;
  }

  .outcomes__list li {
    position: relative;
    padding-left: 1.7em;
    color: var(--on-ink-mute);
  }

  .outcomes__list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .next {
    margin-top: var(--space-6);
    max-width: none;
  }

  @media (max-width: 800px) {
    .glance__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
