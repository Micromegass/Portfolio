---
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/CtaBand.astro';
import { href, type Locale, type PageKey } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  caseKey: 'physio' | 'ikuna';
}

const { locale, caseKey } = Astro.props;
const c = t(locale).cases[caseKey];
const m = t(locale).caseMeta;
const w = t(locale).work;

const page: PageKey = caseKey === 'physio' ? 'case-physio' : 'case-ikuna';
const nextKey = caseKey === 'physio' ? 'ikuna' : 'physio';
const nextPage: PageKey = nextKey === 'physio' ? 'case-physio' : 'case-ikuna';
---

<Base locale={locale} page={page}>
  <article>
    <header class="wrap intro">
      <p data-reveal>
        <a class="intro__back" href={href('work', locale)}>← {m.backLabel}</a>
      </p>
      <span class="eyebrow" data-reveal>{m.kicker} · {c.client}</span>
      <h1 class="intro__title" data-reveal>{c.title}</h1>
      <p class="lead intro__lead" data-reveal>{c.summary}</p>
      <p data-reveal>
        <a class="button" href={c.url} target="_blank" rel="noopener"
          >{w.visitLabel}: {c.urlLabel} ↗</a
        >
      </p>
    </header>

    <section class="wrap" data-reveal>
      <div class="glance">
        <p class="glance__head">{m.specLabel}</p>
        <dl class="glance__grid">
          {
            c.specs.map(({ label, value }) => (
              <div class="glance__row">
                <dt class="glance__label">{label}</dt>
                <dd class="glance__value">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="wrap body">
      {
        c.sections.map((s) => (
          <div class="body__section" data-reveal>
            <h2 class="body__heading">{s.heading}</h2>
            <p class="body__text">{s.body}</p>
          </div>
        ))
      }
    </section>

    <section class="wrap outcomes" data-reveal>
      <div class="outcomes__card">
        <span class="eyebrow">{c.outcomeKicker}</span>
        <ul class="outcomes__list">
          {c.outcomes.map((o) => <li class="outcomes__item">{o}</li>)}
        </ul>
      </div>
    </section>

    <p class="wrap next" data-reveal>
      <a href={href(nextPage, locale)}>{m.nextLabel}: {t(locale).cases[nextKey].client} →</a>
    </p>
  </article>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    padding-top: var(--space-5);
  }

  .intro__back {
    text-decoration: none;
    color: var(--text-soft);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .intro__title {
    max-width: 20ch;
    margin-top: var(--space-2);
  }

  .intro__lead {
    max-width: 40rem;
  }

  .glance {
    margin-top: var(--space-4);
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    box-shadow: var(--shadow-soft);
  }

  .glance__head {
    font-weight: 700;
    font-size: var(--text-sm);
    margin: 0 0 var(--space-3);
  }

  .glance__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin: 0;
  }

  .glance__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .glance__value {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .body {
    margin-top: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .body__heading {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }

  .body__text {
    max-width: var(--content-max);
    color: var(--text-soft);
    font-size: var(--text-md);
    line-height: 1.7;
    margin: 0;
  }

  .outcomes {
    margin-top: var(--space-7);
  }

  .outcomes__card {
    background: var(--bg-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .outcomes__list {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    max-width: var(--content-max);
  }

  .outcomes__item {
    padding: var(--space-2) 0 var(--space-2) 1.6em;
    position: relative;
    font-size: var(--text-md);
  }

  .outcomes__item::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }

  .next {
    margin-top: var(--space-6);
    font-weight: 600;
  }

  @media (max-width: 800px) {
    .glance__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
