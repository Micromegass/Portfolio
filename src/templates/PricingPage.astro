---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaBand from '@/components/CtaBand.astro';
import { href, type Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
const p = c.pricing;
---

<Base locale={locale} page="pricing">
  <!-- Statement -->
  <section class="intro" data-tone="dark">
    <div class="wrap" data-hero-seq>
      <span class="eyebrow">{p.eyebrow}</span>
      <h1 class="intro__title">{p.title}</h1>
      <p class="lead intro__lead">{p.lead}</p>
      <p class="promise">{p.promise}</p>
    </div>
  </section>

  <!-- Building your website: two published prices and one conversation -->
  <section class="band band--curve" data-tone="light">
    <div class="wrap">
      <h2 class="band__title" data-reveal>{p.buildsLabel}</h2>
      <div class="tiers" data-reveal-group>
        {
          p.tiers.map((tier) => (
            <article class:list={['tier', 'card', { 'tier--featured': tier.featured }]}>
              <h3 class="tier__name">{tier.name}</h3>
              {/* Price and "let's talk" occupy the same slot at the same size,
                  so the three cards read as one row of answers. */}
              <p class="tier__price">{tier.price ?? p.talkLabel}</p>
              {tier.priceNote && <p class="tier__price-note">{tier.priceNote}</p>}
              <p class="tier__desc">{tier.desc}</p>

              <dl class="tier__time">
                <dt>{tier.timeLabel}</dt>
                <dd>{tier.time}</dd>
              </dl>

              <h4 class="tier__includes-label">{tier.includesLabel}</h4>
              <ul class="list__items">
                {tier.includes.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>

              <a
                class:list={['button', tier.featured ? 'button--primary' : 'button--ghost', 'tier__cta']}
                href={href('contact', locale)}
              >
                {tier.price ? c.nav.cta : p.talkCta} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Care plans -->
  <section class="band" data-tone="light">
    <div class="wrap">
      <SectionHead eyebrow={p.careEyebrow} title={p.careTitle} intro={p.careIntro} />
      <div class="care" data-reveal-group>
        {
          p.care.map((plan) => (
            <article class="plan card">
              <div class="plan__head">
                <h3 class="plan__name">{plan.name}</h3>
                <p class="plan__price">{plan.price ?? p.talkLabel}</p>
                {plan.priceNote && <p class="plan__price-note">{plan.priceNote}</p>}
              </div>
              <p class="plan__desc">{plan.desc}</p>
              <h4 class="plan__includes-label">{plan.includesLabel}</h4>
              <ul class="list__items">
                {plan.includes.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The small print, said plainly -->
  <section class="band" data-tone="light">
    <div class="wrap">
      <div class="notes" data-reveal>
        <h2 class="notes__title">{p.notesLabel}</h2>
        <ul class="notes__items">
          {p.notes.map((n) => <li>{n}</li>)}
        </ul>
        <p class="notes__updated">{p.updated}</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band" data-tone="light">
    <div class="wrap">
      <h2 class="faq__title" data-reveal>{p.faqLabel}</h2>
      <div class="faq" data-reveal-group>
        {
          p.faq.map((f) => (
            <details class="qa">
              {/* The question lives in a real heading so it appears in the
                  document outline that search and answer engines parse —
                  heading content is valid inside <summary>. */}
              <summary class="qa__q">
                <h3>{f.q}</h3>
              </summary>
              <p class="qa__a">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    background: var(--bg);
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 var(--space-8);
  }

  .intro::before {
    content: '';
    position: absolute;
    width: 52rem;
    height: 52rem;
    top: -30rem;
    right: -16rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 62%);
    pointer-events: none;
  }

  .intro .wrap {
    position: relative;
  }

  .intro__title {
    max-width: 16ch;
    margin: 0 0 var(--space-4);
  }

  .intro__lead {
    max-width: 42rem;
  }

  /* The fixed-price promise is the actual argument of this page, so it gets a
     rule and its own measure rather than sitting in the lead paragraph. */
  .promise {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    max-width: 40rem;
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .band__title,
  .faq__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
    max-width: 20ch;
  }

  /* ---- build tiers ---- */

  /* Cards stretch to a common height so the three buttons land on one line —
     the row has to read as three answers to the same question. */
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .tier {
    padding: var(--space-5) var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
  }

  /* The middle offer is where most businesses land, so it carries the accent
     and the solid button. No badge — the emphasis is visual, not a sales nudge. */
  .tier--featured {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .tier__name {
    font-size: var(--text-md);
    margin: 0 0 var(--space-3);
  }

  .tier__price {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-track);
    font-size: var(--text-xl);
    line-height: 1;
    margin: 0;
    text-wrap: balance;
  }

  .tier__price-note,
  .plan__price-note {
    font-size: var(--text-xs);
    color: var(--fg-mute);
    margin: var(--space-2) 0 0;
    letter-spacing: 0.02em;
  }

  .tier__desc {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin: var(--space-4) 0 0;
    max-width: none;
  }

  .tier__time {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .tier__time dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }

  .tier__time dd {
    margin: var(--space-1) 0 0;
    font-weight: 650;
    font-size: var(--text-sm);
  }

  .tier__includes-label,
  .plan__includes-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-mute);
    margin: var(--space-4) 0 var(--space-3);
  }

  .list__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .list__items li {
    position: relative;
    padding-left: 1.6em;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-mute);
  }

  .list__items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tier__cta {
    margin-top: var(--space-5);
    align-self: flex-start;
  }

  /* Pushes the button to the bottom edge so the three cards end level. */
  .tier .list__items {
    margin-bottom: auto;
  }

  /* ---- care plans ---- */

  .care {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .plan {
    padding: var(--space-5) var(--space-4);
  }

  .plan__head {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .plan__name {
    font-size: var(--text-md);
    margin: 0 0 var(--space-2);
  }

  .plan__price {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-track);
    font-size: var(--text-lg);
    line-height: 1;
    margin: 0;
  }

  .plan__desc {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin: var(--space-3) 0 0;
    max-width: none;
  }

  /* ---- notes ---- */

  .notes {
    max-width: 52rem;
  }

  .notes__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .notes__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .notes__items li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.7;
    border-left: 1px solid var(--line);
  }

  .notes__updated {
    margin: var(--space-5) 0 0;
    font-size: var(--text-xs);
    color: var(--fg-mute);
    letter-spacing: 0.02em;
  }

  /* ---- FAQ (same pattern as the service pages) ---- */

  .faq {
    display: flex;
    flex-direction: column;
    max-width: 52rem;
  }

  .qa {
    border-top: 1px solid var(--line);
  }

  .qa:last-child {
    border-bottom: 1px solid var(--line);
  }

  .qa__q {
    cursor: pointer;
    list-style: none;
    padding: var(--space-4) 2.5rem var(--space-4) 0;
    position: relative;
  }

  .qa__q h3 {
    display: inline;
    font-family: var(--font-body);
    font-weight: 650;
    font-size: var(--text-md);
    letter-spacing: 0;
    margin: 0;
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__q::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--accent-text);
    transition: transform var(--dur) var(--ease);
  }

  .qa[open] .qa__q::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .qa__a {
    color: var(--fg-mute);
    margin: 0 0 var(--space-4);
    max-width: 44rem;
  }

  @media (max-width: 980px) {
    .tiers {
      grid-template-columns: 1fr;
      max-width: 34rem;
    }

    .care {
      grid-template-columns: 1fr;
    }
  }
</style>
