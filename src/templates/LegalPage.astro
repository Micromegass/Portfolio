---
import Base from '@/layouts/Base.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  kind: 'imprint' | 'privacy';
}

const { locale, kind } = Astro.props;
const l = t(locale).legal[kind];
---

<Base locale={locale} page={kind}>
  <section class="legal" data-tone="dark">
    <div class="wrap">
      <h1 class="legal__title">{l.title}</h1>
      {l.body.map((para) => <p class="legal__para">{para}</p>)}
    </div>
  </section>
</Base>

<style>
  .legal {
    background: var(--ink);
    padding: var(--space-7) 0 var(--space-8);
    min-height: 60vh;
  }

  .legal__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }

  .legal__para {
    color: var(--on-ink-mute);
    max-width: 44rem;
  }
</style>
