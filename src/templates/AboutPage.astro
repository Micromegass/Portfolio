---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import PathTimeline from '@/components/PathTimeline.astro';
import CtaBand from '@/components/CtaBand.astro';
import { Image } from 'astro:assets';
import portrait from '@/assets/founder.webp';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const a = t(locale).about;
---

<Base locale={locale} page="about">
  <section class="wrap intro">
    <div class="intro__text">
      <span class="eyebrow" data-reveal>{a.kicker}</span>
      <h1 class="intro__title" data-reveal>{a.title}</h1>
      <p class="lead intro__lead" data-reveal>{a.intro}</p>
    </div>
    <figure class="portrait" data-reveal>
      <Image src={portrait} alt={a.portraitAlt} width={520} densities={[1, 2]} loading="eager" />
    </figure>
  </section>

  <section class="wrap chapters">
    <PathTimeline chapters={a.chapters} />
  </section>

  <section class="wrap now">
    <div class="now__card" data-reveal>
      <span class="eyebrow">{a.now.kicker}</span>
      <h2 class="now__title">{a.now.title}</h2>
      <p class="now__body">{a.now.body}</p>
      <dl class="facts">
        {
          a.facts.map(({ label, value }) => (
            <div class="fact">
              <dt class="fact__label">{label}</dt>
              <dd class="fact__value">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    padding-top: var(--space-6);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  .intro__title {
    max-width: 18ch;
    margin-top: var(--space-2);
  }

  .portrait {
    margin: 0;
    justify-self: center;
  }

  .portrait :global(img) {
    border-radius: var(--radius-arch);
    width: min(100%, 22rem);
    height: auto;
    box-shadow: var(--shadow-soft);
  }

  .chapters {
    margin-top: var(--space-7);
  }

  .now {
    margin-top: var(--space-7);
  }

  .now__card {
    background: var(--bg-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-5);
  }

  .now__title {
    margin: var(--space-2) 0 var(--space-3);
  }

  .now__body {
    color: var(--text-soft);
  }

  .facts {
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .fact__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .fact__value {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .intro__title {
      margin-inline: auto;
    }

    .portrait {
      order: -1;
    }

    .portrait :global(img) {
      width: min(65vw, 17rem);
    }

    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
