---
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/CtaBand.astro';
import { Image } from 'astro:assets';
import portrait from '@/assets/founder.webp';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const a = t(locale).about;
---

<Base locale={locale} page="about">
  <!-- The studio -->
  <section class="intro" data-tone="dark">
    <div class="wrap" data-hero-seq>
      <span class="eyebrow">{a.eyebrow}</span>
      <h1 class="intro__title">{a.title}</h1>
      <p class="lead intro__lead">{a.lead}</p>
    </div>
  </section>

  <section class="band band--curve" data-tone="light">
    <div class="wrap">
      <h2 class="principles__head" data-reveal>{a.principlesLabel}</h2>
      <div class="principles" data-reveal-group>
        {
          a.principles.map((p, i) => (
            <article class="principle">
              <span class="principle__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="principle__title">{p.title}</h3>
              <p class="principle__body">{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The person behind it -->
  <section class="band person" data-tone="light">
    <div class="wrap">
      <div class="person__grid">
        <div data-reveal>
          <span class="eyebrow">{a.personEyebrow}</span>
          <h2 class="person__name">{a.personTitle}</h2>
          <p class="lead">{a.personLead}</p>
          <dl class="facts">
            {
              a.facts.map((f) => (
                <div class="fact">
                  <dt class="fact__label">{f.label}</dt>
                  <dd class="fact__value">{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <figure class="portrait" data-reveal>
          <Image src={portrait} alt={a.portraitAlt} width={520} densities={[1, 2]} loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <!-- The timeline -->
  <section class="band timeline-band" data-tone="dark">
    <div class="wrap">
      <h2 class="timeline__head" data-reveal>{a.timelineLabel}</h2>
      <ol class="timeline" data-reveal-group>
        {
          a.timeline.map((item) => (
            <li class="stop">
              <div class="stop__marker" aria-hidden="true" />
              <div class="stop__content">
                <span class="stop__period">{item.period}</span>
                <h3 class="stop__title">{item.title}</h3>
                <p class="stop__body">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    background: var(--bg);
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 var(--space-8);
  }

  .intro::before {
    content: '';
    position: absolute;
    width: 52rem;
    height: 52rem;
    top: -30rem;
    right: -16rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 62%);
    pointer-events: none;
  }

  .intro .wrap {
    position: relative;
  }

  .intro__title {
    max-width: 17ch;
    margin: 0 0 var(--space-4);
  }

  .intro__lead {
    max-width: 44rem;
  }

  .principles__head,
  .timeline__head {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .principle {
    border-top: 2px solid var(--accent);
    padding-top: var(--space-3);
  }

  .principle__num {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }

  .principle__title {
    font-size: var(--text-md);
    margin: var(--space-2) 0;
  }

  .principle__body {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  .person__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  .person__name {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-3);
  }

  .facts {
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .fact {
    border-top: 1px solid var(--line);
    padding-top: var(--space-2);
  }

  .fact__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }

  .fact__value {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  .portrait {
    margin: 0;
    position: relative;
  }

  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(16px, 16px);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .portrait :global(img) {
    position: relative;
    border-radius: var(--radius-lg);
    width: 100%;
    height: auto;
  }

  /* Timeline: the personal story, kept deliberately downstream */
  .timeline-band {
    background: var(--bg);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    max-width: 46rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--accent),
      color-mix(in srgb, var(--accent) 25%, transparent)
    );
  }

  .stop {
    position: relative;
    padding-left: var(--space-5);
    padding-bottom: var(--space-5);
  }

  .stop:last-child {
    padding-bottom: 0;
  }

  .stop__marker {
    position: absolute;
    left: 0;
    top: 7px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--accent);
  }

  .stop__period {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .stop__title {
    font-size: var(--text-md);
    margin: var(--space-2) 0;
  }

  .stop__body {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.75;
    margin: 0;
  }

  @media (max-width: 900px) {
    .principles,
    .person__grid,
    .facts {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 20rem;
    }
  }
</style>
