---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaBand from '@/components/CtaBand.astro';
import { Image } from 'astro:assets';
import portrait from '@/assets/founder.webp';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const a = t(locale).about;
---

<Base locale={locale} page="about" sheet="04">
  <section class="sheet intro">
    <div class="intro__text">
      <span class="anno anno--mark" data-reveal>{a.kicker}</span>
      <h1 class="intro__title" data-reveal>{a.title}</h1>
      <p class="lead intro__lead" data-reveal>{a.intro}</p>
    </div>
    <figure class="portrait" data-reveal>
      <Image src={portrait} alt={a.portraitAlt} width={520} densities={[1, 2]} loading="eager" />
      <figcaption class="anno portrait__caption">Axel Braunschweiger</figcaption>
    </figure>
  </section>

  <!-- The arc, drawn as revisions of one person -->
  <section class="sheet chapters">
    {
      a.chapters.map((ch, i) => (
        <article class="chapter" data-reveal>
          <div class="chapter__meta">
            <span class="anno anno--mark">REV. {String(i + 1).padStart(2, '0')}</span>
            <span class="anno chapter__period">{ch.period}</span>
          </div>
          <div class="chapter__main">
            <h2 class="chapter__title">{ch.title}</h2>
            <p class="chapter__body">{ch.body}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="sheet now">
    <SectionHead fig="02" kicker={a.now.kicker} title={a.now.title} />
    <p class="lead" data-reveal>{a.now.body}</p>
    <dl class="facts" data-reveal-group>
      {
        a.facts.map(({ label, value }) => (
          <div class="fact">
            <dt class="anno fact__label">{label}</dt>
            <dd class="fact__value">{value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    padding-top: var(--space-7);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .intro__title {
    max-width: 16ch;
    margin-top: var(--space-3);
  }

  .intro__lead {
    color: var(--ink-soft);
  }

  .portrait {
    margin: 0;
    border: 1.5px solid var(--ink);
    background: var(--paper-raised);
    padding: var(--space-2);
  }

  .portrait :global(img) {
    width: 100%;
    height: auto;
  }

  .portrait__caption {
    display: block;
    padding-top: var(--space-2);
    text-align: right;
    color: var(--ink-faint);
  }

  .chapters {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .chapter {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1.5px solid var(--ink);
  }

  .chapter__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .chapter__period {
    color: var(--ink-faint);
  }

  .chapter__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
    max-width: 24ch;
  }

  .chapter__body {
    color: var(--ink-soft);
    max-width: var(--content-max);
  }

  .now {
    margin-top: var(--space-8);
  }

  .facts {
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .fact {
    border-top: 1.5px solid var(--ink);
    padding-top: var(--space-2);
  }

  .fact__label {
    color: var(--ink-faint);
  }

  .fact__value {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 22rem;
    }

    .chapter {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .chapter__meta {
      flex-direction: row;
      gap: var(--space-3);
    }

    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
