---
import Base from '@/layouts/Base.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale).contact;
---

<Base locale={locale} page="contact">
  <section class="wrap contact">
    <span class="eyebrow" data-reveal>{c.kicker}</span>
    <h1 class="contact__title" data-reveal>{c.title}</h1>
    <p class="lead contact__body" data-reveal>{c.body}</p>

    <div class="email-card" data-reveal>
      <p class="email-card__label">{c.emailLabel}</p>
      <a class="email-card__address" href={`mailto:${c.email}`}>{c.email}</a>
      <p class="email-card__meta">
        <span class="email-card__pulse" aria-hidden="true"></span>
        {c.availability}
      </p>
    </div>

    <p class="contact__langs" data-reveal>{c.languagesNote}</p>
  </section>
</Base>

<style>
  .contact {
    padding-top: var(--space-6);
    min-height: 55vh;
    text-align: center;
  }

  .contact__title {
    max-width: 18ch;
    margin: var(--space-2) auto var(--space-4);
  }

  .contact__body {
    max-width: 34rem;
    margin-inline: auto;
  }

  .email-card {
    margin: var(--space-6) auto 0;
    max-width: 34rem;
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-5);
    box-shadow: var(--shadow-soft);
  }

  .email-card__label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-faint);
    margin: 0 0 var(--space-2);
  }

  .email-card__address {
    font-family: var(--font-display);
    font-variation-settings: var(--display-settings);
    font-weight: 600;
    font-size: var(--text-lg);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .email-card__meta {
    margin: var(--space-4) 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--text-soft);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .email-card__pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }

  .contact__langs {
    margin: var(--space-5) auto 0;
    color: var(--text-soft);
    font-style: italic;
  }
</style>
