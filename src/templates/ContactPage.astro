---
import Base from '@/layouts/Base.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale).contact;
---

<Base locale={locale} page="contact" sheet="05">
  <section class="sheet contact">
    <span class="anno anno--mark" data-reveal>{c.kicker}</span>
    <h1 class="contact__title" data-reveal>{c.title}</h1>
    <p class="lead contact__body" data-reveal>{c.body}</p>

    <div class="email-block" data-reveal>
      <span class="anno email-block__label">{c.emailLabel}</span>
      <a class="email-block__address" href={`mailto:${c.email}`}>{c.email}</a>
      <svg class="email-block__line" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" data-draw>
        <line x1="1" y1="1" x2="1" y2="9"></line>
        <line x1="1" y1="5" x2="99" y2="5"></line>
        <line x1="99" y1="1" x2="99" y2="9"></line>
      </svg>
      <p class="email-block__meta anno">
        <span class="email-block__pulse" aria-hidden="true"></span>
        {c.availability}
      </p>
    </div>

    <p class="contact__langs" data-reveal>{c.languagesNote}</p>
  </section>
</Base>

<style>
  .contact {
    padding-top: var(--space-7);
    min-height: 55vh;
  }

  .contact__title {
    max-width: 16ch;
    margin-top: var(--space-3);
  }

  .contact__body {
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .email-block {
    margin-top: var(--space-6);
    display: inline-flex;
    flex-direction: column;
    min-width: min(34rem, 100%);
  }

  .email-block__label {
    color: var(--ink-faint);
  }

  .email-block__address {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 110, 'wght' 600;
    font-size: var(--text-lg);
    color: var(--ink);
    text-decoration: none;
    margin-top: var(--space-2);
    overflow-wrap: anywhere;
  }

  .email-block__address:hover {
    color: var(--accent-text);
  }

  .email-block__line {
    width: 100%;
    height: 10px;
    margin-top: var(--space-2);
    overflow: visible;
  }

  .email-block__line line {
    stroke: var(--mark);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .email-block__meta {
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-soft);
  }

  .email-block__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1a7f37;
  }

  .contact__langs {
    margin-top: var(--space-5);
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
