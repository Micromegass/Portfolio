---
import Base from '@/layouts/Base.astro';
import { studio, type Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale).contact;
---

<Base locale={locale} page="contact">
  <section class="contact" data-tone="dark">
    <div class="wrap contact__grid">
      <div data-hero-seq>
        <span class="eyebrow">{c.eyebrow}</span>
        <h1 class="contact__title">{c.title}</h1>
        <p class="lead">{c.body}</p>

        <a class="mailto" href={`mailto:${studio.email}`}>
          <span class="mailto__label">{c.emailLabel}</span>
          <span class="mailto__address">{studio.email}</span>
        </a>

        <p class="status">
          <span class="status__dot" aria-hidden="true"></span>
          {c.availability}
        </p>
        <p class="langs">{c.languagesNote}</p>
      </div>

      <aside class="review card" data-reveal>
        <h2 class="review__title">{c.reviewTitle}</h2>
        <p class="review__body">{c.reviewBody}</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    background: var(--bg);
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 var(--space-8);
    min-height: 70vh;
  }

  .contact::before {
    content: '';
    position: absolute;
    width: 52rem;
    height: 52rem;
    top: -28rem;
    right: -16rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 20%, transparent), transparent 62%);
    pointer-events: none;
  }

  .contact__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .contact__title {
    max-width: 16ch;
    margin: 0 0 var(--space-4);
  }

  .mailto {
    display: inline-flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-6);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: var(--space-2);
  }

  .mailto__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }

  .mailto__address {
    font-family: var(--font-display);
    font-weight: 780;
    letter-spacing: -0.03em;
    font-size: var(--text-lg);
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .mailto:hover .mailto__address {
    color: var(--accent);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: var(--space-5);
    color: var(--fg);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .status__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #46d67f;
  }

  .langs {
    color: var(--fg-mute);
    font-size: var(--text-sm);
  }

  .review {
    background: var(--surface);
    border-color: var(--line);
    padding: var(--space-5);
  }

  .review__title {
    font-size: var(--text-md);
    margin: 0 0 var(--space-3);
  }

  .review__body {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
