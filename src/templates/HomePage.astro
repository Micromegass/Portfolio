---
import Base from '@/layouts/Base.astro';
import PathTimeline from '@/components/PathTimeline.astro';
import SectionHead from '@/components/SectionHead.astro';
import CaseCard from '@/components/CaseCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { Image } from 'astro:assets';
import portrait from '@/assets/founder.webp';
import { href, type Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h = t(locale).home;
const about = t(locale).about;
---

<Base locale={locale} page="home">
  <!-- Hero: a person first, a service second -->
  <section class="hero wrap">
    <div class="hero__text">
      <p class="eyebrow" data-reveal>{h.kicker}</p>
      <h1 class="hero__headline" data-reveal>
        {h.headline[0]}<br />
        <em class="hero__accent">{h.headline[1]}</em>
      </h1>
      <p class="lead hero__sub" data-reveal>{h.sub}</p>
      <div class="hero__actions" data-reveal>
        <a class="button button--primary" href={href('contact', locale)}>{h.cta.primary} →</a>
        <a class="button" href={href('work', locale)}>{h.cta.secondary}</a>
      </div>
    </div>
    <figure class="hero__portrait" data-reveal>
      <Image src={portrait} alt={about.portraitAlt} width={560} densities={[1, 2]} loading="eager" />
    </figure>
  </section>

  <!-- Friendly proof numbers -->
  <section class="wrap stats" data-reveal-group>
    {
      h.dims.map(({ value, label }) => (
        <div class="stat">
          <span class="stat__value">{Number(value)}</span>
          <span class="stat__label">{label}</span>
        </div>
      ))
    }
  </section>

  <!-- The chronological journey -->
  <section class="wrap section">
    <SectionHead centered kicker={h.journey.kicker} title={h.journey.title} />
    <p class="lead journey__intro" data-reveal>{h.journey.intro}</p>
    <PathTimeline chapters={about.chapters} />
    <p class="journey__more" data-reveal>
      <a class="button" href={href('about', locale)}>{h.journey.link} →</a>
    </p>
  </section>

  <!-- Services, condensed -->
  <section class="services-band">
    <div class="wrap">
      <SectionHead centered kicker={h.services.kicker} title={h.services.title} />
      <div class="services-grid" data-reveal-group>
        {
          h.services.items.map((item) => (
            <div class="service">
              <h3 class="service__title">{item.title}</h3>
              <p class="service__desc">{item.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="section__more" data-reveal>
        <a class="button" href={href('services', locale)}>{h.services.link} →</a>
      </p>
    </div>
  </section>

  <!-- Featured work -->
  <section class="wrap section">
    <SectionHead centered kicker={h.work.kicker} title={h.work.title} />
    <div class="work-grid" data-reveal-group>
      <CaseCard locale={locale} caseKey="physio" />
      <CaseCard locale={locale} caseKey="ikuna" />
    </div>
    <p class="section__more" data-reveal>
      <a class="button" href={href('work', locale)}>{h.work.link} →</a>
    </p>
  </section>

  {
    h.testimonial.quote && (
      <section class="wrap section" data-reveal>
        <blockquote class="testimonial">
          <p class="lead">“{h.testimonial.quote}”</p>
          <cite>{h.testimonial.attribution}</cite>
        </blockquote>
      </section>
    )
  }

  <CtaBand locale={locale} />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: var(--space-6);
    align-items: center;
    padding-top: var(--space-7);
  }

  .hero__headline {
    max-width: 15ch;
  }

  .hero__accent {
    font-style: italic;
    color: var(--green);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }

  .hero__sub {
    max-width: 33rem;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .hero__portrait {
    margin: 0;
    justify-self: center;
  }

  .hero__portrait :global(img) {
    border-radius: var(--radius-arch);
    width: min(100%, 24rem);
    height: auto;
    box-shadow: var(--shadow-soft);
  }

  .stats {
    display: flex;
    justify-content: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-top: var(--space-7);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat__value {
    font-family: var(--font-display);
    font-variation-settings: var(--display-settings);
    font-weight: var(--display-weight);
    font-size: var(--text-xl);
    color: var(--green-dark);
    line-height: 1;
  }

  .stat__label {
    margin-top: var(--space-2);
    color: var(--text-soft);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .section {
    margin-top: var(--space-8);
  }

  .journey__intro {
    text-align: center;
    margin: calc(-1 * var(--space-3)) auto var(--space-5);
  }

  .journey__more,
  .section__more {
    text-align: center;
    margin-top: var(--space-5);
  }

  .services-band {
    margin-top: var(--space-8);
    background: var(--bg-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-7) 0;
    margin-inline: var(--space-3);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .service {
    background: var(--card);
    border-radius: var(--radius);
    padding: var(--space-4);
    box-shadow: var(--shadow-soft);
  }

  .service__title {
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
  }

  .service__desc {
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .testimonial {
    margin: 0 auto;
    max-width: 40rem;
    text-align: center;
  }

  .testimonial cite {
    display: block;
    margin-top: var(--space-3);
    color: var(--text-faint);
    font-style: normal;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: var(--space-5);
    }

    .hero__headline,
    .hero__sub {
      margin-inline: auto;
    }

    .hero__actions {
      justify-content: center;
    }

    .hero__portrait {
      order: -1;
    }

    .hero__portrait :global(img) {
      width: min(70vw, 18rem);
    }

    .services-grid,
    .work-grid {
      grid-template-columns: 1fr;
    }

    .services-band {
      margin-inline: 0;
      border-radius: 0;
    }
  }
</style>
