---
import Base from '@/layouts/Base.astro';
import Transformer from '@/components/Transformer.astro';
import HeroCheck from '@/components/HeroCheck.astro';
import SectionHead from '@/components/SectionHead.astro';
import CaseCard from '@/components/CaseCard.astro';
import BuildCard from '@/components/BuildCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { href, servicePages, type Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
const h = c.home;

// The homepage shows client projects in flight; in-house products stay on the
// Work page. This also keeps the two-up grid even.
const homeBuilds = c.work.builds.filter((b) => b.key !== 'trazo');
---

<Base locale={locale} page="home">
  <!-- Hero: the thesis is the transformation itself -->
  <section class="hero" data-tone="dark">
    <div class="wrap">
      <div class="hero__grid">
        <div data-hero-seq>
          <span class="eyebrow">{h.eyebrow}</span>
          <h1 class="hero__headline">
            {h.headline[0]}<br />{h.headline[1]}<br /><em>{h.headline[2]}</em>
          </h1>
          <p class="lead hero__sub">{h.sub}</p>
          <HeroCheck locale={locale} />
          <p class="hero__secondary">
            <a class="arrow-link" href={href('work', locale)}>{h.ctaSecondary} <span>→</span></a>
          </p>
        </div>

        <dl class="facts" data-reveal-group>
          {
            h.facts.map((f) => (
              <div class="fact">
                <dt class="fact__label">{f.label}</dt>
                <dd class="fact__value">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <Transformer locale={locale} />
    </div>
  </section>

  <!-- Services -->
  <section class="band band--curve" data-tone="light">
    <div class="wrap">
      <SectionHead eyebrow={h.services.eyebrow} title={h.services.title} intro={h.services.intro} />
      <div class="services" data-reveal-group>
        {
          servicePages.map((key, i) => (
            <article class="svc card card--hover">
              <span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc__title">{c.services[key].cardTitle}</h3>
              <p class="svc__desc">{c.services[key].cardDesc}</p>
              {/* Anchor text names the service for search engines and screen
                  readers; the visible label stays short. */}
              <a class="arrow-link svc__link" href={href(key, locale)}>
                {h.services.more}
                <span class="sr-only">: {c.services[key].cardTitle}</span> <span>→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="band" data-tone="light">
    <div class="wrap">
      <SectionHead eyebrow={h.work.eyebrow} title={h.work.title} intro={h.work.intro} />
      <div class="cases" data-reveal-group>
        <CaseCard locale={locale} caseKey="physio" />
        <CaseCard locale={locale} caseKey="ikuna" />
      </div>
    </div>
  </section>

  <!-- Current builds: client work in flight, not yet launched -->
  <section class="band" data-tone="light">
    <div class="wrap">
      <SectionHead
        eyebrow={c.work.buildsEyebrow}
        title={c.work.buildsTitle}
        intro={c.work.buildsIntro}
      />
      <div class="builds" data-reveal-group>
        {homeBuilds.map((build) => <BuildCard locale={locale} build={build} />)}
      </div>
      <p class="more" data-reveal>
        <a class="button button--ghost" href={href('work', locale)}>{h.work.more}</a>
      </p>
    </div>
  </section>

  <!-- Process -->
  <section class="band" data-tone="light">
    <div class="wrap">
      <SectionHead eyebrow={h.process.eyebrow} title={h.process.title} />
      <ol class="steps" data-reveal-group>
        {
          h.process.steps.map((s, i) => (
            <li class="step">
              <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__body">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    h.testimonial.quote && (
      <section class="band" data-tone="light" data-reveal>
        <div class="wrap">
          <blockquote class="quote">
            <p>“{h.testimonial.quote}”</p>
            <cite>{h.testimonial.attribution}</cite>
          </blockquote>
        </div>
      </section>
    )
  }

  <CtaBand locale={locale} />
</Base>

<style>
  .hero {
    background: var(--bg);
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 var(--space-8);
  }

  .hero::before {
    content: '';
    position: absolute;
    width: 58rem;
    height: 58rem;
    top: -32rem;
    right: -18rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 20%, transparent), transparent 62%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-6);
    align-items: end;
  }

  .hero__headline {
    margin: 0 0 var(--space-4);
  }

  .hero__headline em {
    font-style: normal;
    color: var(--accent);
  }

  .hero__sub {
    max-width: 32rem;
  }

  .hero__secondary {
    margin: var(--space-4) 0 0;
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding-bottom: var(--space-2);
  }

  .fact {
    border-top: 1px solid var(--line);
    padding-top: var(--space-3);
    display: flex;
    flex-direction: column;
  }

  .fact__value {
    font-family: var(--font-display);
    font-weight: 780;
    letter-spacing: -0.03em;
    font-size: 1.7rem;
    margin: 0;
    order: 1;
  }

  .fact__label {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    order: 2;
  }

  /* ---- light sections ---- */
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .svc {
    padding: var(--space-4) var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .svc__num {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--accent-text);
  }

  .svc__title {
    margin: 0;
  }

  .svc__desc {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin: 0;
  }

  .svc__link {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .cases,
  .builds {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .more {
    text-align: center;
    margin: var(--space-5) 0 0;
    max-width: none;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .step {
    border-top: 2px solid var(--accent);
    padding-top: var(--space-3);
  }

  .step__num {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }

  .step__title {
    font-size: var(--text-md);
    margin: var(--space-2) 0;
  }

  .step__body {
    font-size: var(--text-sm);
    color: var(--fg-mute);
    line-height: 1.65;
    margin: 0;
  }

  .quote {
    margin: 0 auto;
    max-width: 42rem;
    text-align: center;
  }

  .quote p {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 0 auto var(--space-3);
  }

  .quote cite {
    color: var(--fg-mute);
    font-style: normal;
    font-size: var(--text-sm);
    font-weight: 650;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .facts {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .fact {
      flex: 1 1 9rem;
    }

    .services,
    .cases,
    .builds,
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
