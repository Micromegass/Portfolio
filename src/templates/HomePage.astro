---
import Base from '@/layouts/Base.astro';
import DimRow from '@/components/DimRow.astro';
import ScaleStory from '@/components/ScaleStory.astro';
import SectionHead from '@/components/SectionHead.astro';
import CaseCard from '@/components/CaseCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { href, type Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h = t(locale).home;
---

<Base locale={locale} page="home" sheet="01">
  <!-- Hero -->
  <section class="hero sheet">
    <p class="anno hero__kicker" data-reveal>{h.kicker}</p>
    <h1 class="hero__headline" data-reveal>
      <span>{h.headline[0]}</span>
      <span class="hero__headline-accent">{h.headline[1]}</span>
    </h1>
    <p class="lead hero__sub" data-reveal>{h.sub}</p>

    <div class="hero__actions" data-reveal>
      <a class="button button--primary" href={href('contact', locale)}>{h.cta.primary} →</a>
      <a class="button" href={href('work', locale)}>{h.cta.secondary}</a>
    </div>

    <div class="hero__dims">
      <DimRow dims={h.dims} />
    </div>
  </section>

  <!-- The bold moment -->
  <ScaleStory locale={locale} />

  <!-- Services, condensed -->
  <section class="sheet section">
    <SectionHead fig="02" kicker={h.services.kicker} title={h.services.title} />
    <div class="services-grid" data-reveal-group>
      {
        h.services.items.map((item) => (
          <div class="service">
            <h3 class="service__title">{item.title}</h3>
            <p class="service__desc">{item.desc}</p>
          </div>
        ))
      }
    </div>
    <p class="section__more" data-reveal>
      <a href={href('services', locale)}>{h.services.link} →</a>
    </p>
  </section>

  <!-- Featured work -->
  <section class="sheet section">
    <SectionHead fig="03" kicker={h.work.kicker} title={h.work.title} />
    <div class="work-grid" data-reveal-group>
      <CaseCard locale={locale} caseKey="physio" index="01" />
      <CaseCard locale={locale} caseKey="ikuna" index="02" />
    </div>
    <p class="section__more" data-reveal>
      <a href={href('work', locale)}>{h.work.link} →</a>
    </p>
  </section>

  <!-- Story teaser -->
  <section class="sheet section">
    <SectionHead fig="04" kicker={h.story.kicker} title={h.story.title} />
    <p class="lead story__body" data-reveal>{h.story.body}</p>
    <p class="section__more" data-reveal>
      <a href={href('about', locale)}>{h.story.link} →</a>
    </p>
  </section>

  {
    h.testimonial.quote && (
      <section class="sheet section" data-reveal>
        <SectionHead fig="05" kicker={h.testimonial.kicker} title="" />
        <blockquote class="testimonial">
          <p class="lead">“{h.testimonial.quote}”</p>
          <cite class="anno">{h.testimonial.attribution}</cite>
        </blockquote>
      </section>
    )
  }

  <CtaBand locale={locale} />
</Base>

<style>
  .hero {
    padding-top: var(--space-7);
    min-height: 72vh;
  }

  .hero__kicker {
    display: block;
    margin-bottom: var(--space-4);
  }

  .hero__headline {
    max-width: 12ch;
  }

  .hero__headline span {
    display: block;
  }

  .hero__headline-accent {
    color: var(--accent-text);
  }

  .hero__sub {
    max-width: 36rem;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .button {
    font-family: var(--font-anno);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    border: 1.5px solid var(--ink);
    padding: var(--space-3) var(--space-4);
    background: var(--paper-raised);
    transition:
      background var(--dur-quick) var(--ease-draft),
      color var(--dur-quick) var(--ease-draft),
      border-color var(--dur-quick) var(--ease-draft);
  }

  .button:hover {
    border-color: var(--mark);
    color: var(--accent-text);
  }

  .button--primary {
    background: var(--ink);
    color: var(--paper);
  }

  .button--primary:hover {
    background: var(--mark);
    border-color: var(--mark);
    color: var(--paper);
  }

  .hero__dims {
    margin-top: var(--space-6);
  }

  .section {
    margin-top: var(--space-8);
  }

  .section__more {
    margin-top: var(--space-4);
    font-family: var(--font-anno);
    font-size: var(--text-sm);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .service {
    border-top: 1.5px solid var(--ink);
    padding-top: var(--space-3);
  }

  .service__title {
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
  }

  .service__desc {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .story__body {
    max-width: 40rem;
  }

  .testimonial {
    margin: 0;
  }

  @media (max-width: 800px) {
    .services-grid,
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
