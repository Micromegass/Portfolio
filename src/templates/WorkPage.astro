---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import CaseCard from '@/components/CaseCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
const w = c.work;
---

<Base locale={locale} page="work">
  <section class="intro" data-tone="dark">
    <div class="wrap" data-hero-seq>
      <span class="eyebrow">{w.eyebrow}</span>
      <h1 class="intro__title">{w.title}</h1>
      <p class="lead">{w.intro}</p>
    </div>
  </section>

  <section class="band band--curve" data-tone="light">
    <div class="wrap">
      <div class="cases" data-reveal-group>
        <CaseCard locale={locale} caseKey="physio" />
        <CaseCard locale={locale} caseKey="ikuna" />
      </div>
    </div>
  </section>

  <section class="band" data-tone="light">
    <div class="wrap">
      <SectionHead eyebrow={w.labEyebrow} title={w.labTitle} intro={w.labIntro} />
      <div class="lab" data-reveal-group>
        {
          w.lab.map((item) => (
            <article class="lab-card card">
              <h3 class="lab-card__title">{item.title}</h3>
              <p class="lab-card__desc">{item.desc}</p>
              <span class="lab-card__tag">
                <span class="dot" aria-hidden="true" />
                {item.tag}
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    background: var(--bg);
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 var(--space-8);
  }

  .intro::before {
    content: '';
    position: absolute;
    width: 52rem;
    height: 52rem;
    top: -30rem;
    right: -16rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 62%);
    pointer-events: none;
  }

  .intro .wrap {
    position: relative;
  }

  .intro__title {
    max-width: 18ch;
    margin: 0 0 var(--space-4);
  }

  .cases {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .lab {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .lab-card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-style: dashed;
  }

  .lab-card__title {
    font-size: var(--text-md);
    margin: 0;
  }

  .lab-card__desc {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .lab-card__tag {
    margin-top: auto;
    padding-top: var(--space-3);
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 1000px) {
    .lab {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 700px) {
    .cases,
    .lab {
      grid-template-columns: 1fr;
    }
  }
</style>
