---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import CaseCard from '@/components/CaseCard.astro';
import BuildCard from '@/components/BuildCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
const w = c.work;
---

<Base locale={locale} page="work">
  <section class="intro" data-tone="dark">
    <div class="wrap" data-hero-seq>
      <span class="eyebrow">{w.eyebrow}</span>
      <h1 class="intro__title">{w.title}</h1>
      <p class="lead">{w.intro}</p>
    </div>
  </section>

  <section class="band band--curve" data-tone="light">
    <div class="wrap">
      <SectionHead eyebrow={w.casesEyebrow} title={w.casesTitle} intro={w.casesIntro} />
      <div class="cases" data-reveal-group>
        <CaseCard locale={locale} caseKey="physio" as="h3" />
        <CaseCard locale={locale} caseKey="ikuna" as="h3" />
      </div>
    </div>
  </section>

  <section class="band" data-tone="light">
    <div class="wrap">
      <SectionHead eyebrow={w.buildsEyebrow} title={w.buildsTitle} intro={w.buildsIntro} />
      <div class="builds" data-reveal-group>
        {w.builds.map((build) => <BuildCard locale={locale} build={build} as="h3" />)}
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    background: var(--bg);
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 var(--space-8);
  }

  .intro::before {
    content: '';
    position: absolute;
    width: 52rem;
    height: 52rem;
    top: -30rem;
    right: -16rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 62%);
    pointer-events: none;
  }

  .intro .wrap {
    position: relative;
  }

  .intro__title {
    max-width: 18ch;
    margin: 0 0 var(--space-4);
  }

  .cases {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .builds {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  @media (max-width: 700px) {
    .cases,
    .builds {
      grid-template-columns: 1fr;
    }
  }
</style>
