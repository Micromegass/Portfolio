---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import CaseCard from '@/components/CaseCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const w = t(locale).work;
---

<Base locale={locale} page="work">
  <section class="wrap intro">
    <span class="eyebrow" data-reveal>{w.kicker}</span>
    <h1 class="intro__title" data-reveal>{w.title}</h1>
    <p class="lead intro__lead" data-reveal>{w.intro}</p>
  </section>

  <section class="wrap cases">
    <div class="work-grid" data-reveal-group>
      <CaseCard locale={locale} caseKey="physio" />
      <CaseCard locale={locale} caseKey="ikuna" />
    </div>
  </section>

  <section class="wrap employment" data-reveal>
    <div class="employment__card">
      <span class="eyebrow">{w.employment.kicker}</span>
      <h2 class="employment__title">{w.employment.title}</h2>
      <p class="employment__body">{w.employment.body}</p>
      <ul class="stack-list">
        {w.employment.stack.map((tech) => <li class="stack-list__item">{tech}</li>)}
      </ul>
    </div>
  </section>

  <section class="wrap lab">
    <SectionHead centered kicker={w.lab.kicker} title={w.lab.title} />
    <p class="lead lab__intro" data-reveal>{w.lab.intro}</p>
    <div class="lab__grid" data-reveal-group>
      {
        w.lab.items.map((item) => (
          <article class="lab-card">
            <h3 class="lab-card__title">{item.title}</h3>
            <p class="lab-card__desc">{item.desc}</p>
            <p class="lab-card__status">
              <span class="lab-card__pulse" aria-hidden="true" />
              {item.status}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .intro {
    padding-top: var(--space-6);
  }

  .intro__title {
    max-width: 22ch;
    margin-top: var(--space-2);
  }

  .intro__lead {
    max-width: 38rem;
  }

  .cases {
    margin-top: var(--space-6);
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .employment {
    margin-top: var(--space-7);
  }

  .employment__card {
    background: var(--bg-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-5);
  }

  .employment__title {
    margin: var(--space-2) 0 var(--space-3);
  }

  .employment__body {
    color: var(--text-soft);
    max-width: var(--content-max);
  }

  .stack-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .stack-list__item {
    background: var(--card);
    border-radius: 999px;
    padding: 0.35em 1em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-soft);
  }

  .lab {
    margin-top: var(--space-8);
  }

  .lab__intro {
    text-align: center;
    margin: calc(-1 * var(--space-3)) auto var(--space-5);
  }

  .lab__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .lab-card {
    background: var(--card);
    border: 1.5px dashed color-mix(in srgb, var(--green) 35%, transparent);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .lab-card__title {
    font-size: var(--text-md);
    margin: 0 0 var(--space-2);
  }

  .lab-card__desc {
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  .lab-card__status {
    margin: var(--space-3) 0 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--green-dark);
  }

  .lab-card__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }

  @media (max-width: 800px) {
    .work-grid,
    .lab__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
