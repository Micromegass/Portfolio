---
import { href, alternates, type Locale, type PageKey } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const nav = t(locale).nav;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links: { key: PageKey; label: string }[] = [
  { key: 'services', label: nav.services },
  { key: 'work', label: nav.work },
  { key: 'about', label: nav.about },
  { key: 'contact', label: nav.contact },
];

const langLinks = alternates(page).map(({ locale: l, path }) => ({
  locale: l,
  url: base + path,
  active: l === locale,
}));
---

<header class="header wrap">
  <a class="wordmark" href={href('home', locale)} title={nav.homeAria}>Axel Braunschweiger</a>

  <nav class="nav" aria-label={nav.menuLabel}>
    {links.map(({ key, label }) => (
      <a class:list={['nav__link', { 'nav__link--active': key === page }]} href={href(key, locale)}
        >{label}</a
      >
    ))}
  </nav>

  <nav class="langs" aria-label="Language">
    {langLinks.map(({ locale: l, url, active }) =>
      active ? (
        <span class="langs__item langs__item--active" aria-current="true">{l.toUpperCase()}</span>
      ) : (
        <a class="langs__item" href={url} lang={l} hreflang={l}>{l.toUpperCase()}</a>
      )
    )}
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
  }

  .wordmark {
    font-family: var(--font-display);
    font-variation-settings: var(--display-settings);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }

  .wordmark:hover {
    color: var(--green-dark);
  }

  .nav {
    display: flex;
    gap: var(--space-1);
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    padding: 4px;
  }

  .nav__link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-soft);
    text-decoration: none;
    padding: 0.45em 1em;
    border-radius: 999px;
    transition:
      background var(--dur-quick) var(--ease-calm),
      color var(--dur-quick) var(--ease-calm);
  }

  .nav__link:hover {
    color: var(--green-dark);
    background: var(--bg-soft);
  }

  .nav__link--active {
    background: var(--green);
    color: #fff;
  }

  .nav__link--active:hover {
    background: var(--green-dark);
    color: #fff;
  }

  .langs {
    display: flex;
    gap: 2px;
  }

  .langs__item {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-soft);
    text-decoration: none;
    padding: 0.35em 0.6em;
    border-radius: 999px;
  }

  a.langs__item:hover {
    color: var(--green-dark);
    background: var(--bg-soft);
  }

  .langs__item--active {
    background: var(--bg-soft);
    color: var(--text);
  }

  @media (max-width: 720px) {
    .header {
      justify-content: center;
    }

    .wordmark {
      margin-right: 0;
      width: 100%;
      text-align: center;
    }
  }
</style>
