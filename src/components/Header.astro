---
import { href, alternates, localeLabels, studio, type Locale, type PageKey } from '@/lib/i18n';
import { t } from '@/data';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Logo from '@/components/Logo.astro';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const c = t(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const langLinks = alternates(page).map(({ locale: l, path }) => ({
  locale: l,
  url: base + path,
  active: l === locale,
}));
---

<header class="site-header">
  <div class="wrap header__row">
    <a class="mark" href={href('home', locale)} title={c.nav.homeAria}>
      <Logo size={34} />
      <span class="mark__text">
        <span class="mark__name">{studio.name}</span>
        <span class="mark__sub">{studio.tagline[locale]}</span>
      </span>
    </a>

    <nav class="nav" id="site-nav" aria-label={c.nav.menuLabel}>
      {
        c.nav.items.map((item) => (
          <a
            class:list={['nav__link', { 'nav__link--active': item.page === page }]}
            href={href(item.page, locale)}
            aria-current={item.page === page ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header__end">
      <nav class="langs" aria-label="Language">
        {
          /* The visible label is the two-letter code; assistive tech gets the
             full language name, which "E N" spelled out is not. */
          langLinks.map(({ locale: l, url, active }) =>
            active ? (
              <span class="langs__item langs__item--active" aria-current="true">
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="sr-only">{localeLabels[l]}</span>
              </span>
            ) : (
              <a class="langs__item" href={url} lang={l} hreflang={l} title={localeLabels[l]}>
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="sr-only">{localeLabels[l]}</span>
              </a>
            )
          )
        }
      </nav>

      <ThemeToggle locale={locale} />

      <a class="button button--primary header__cta" href={href('contact', locale)}>{c.nav.cta}</a>

      <button
        class="burger"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label={c.nav.openMenu}
        data-open-label={c.nav.openMenu}
        data-close-label={c.nav.closeMenu}
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const header = document.querySelector<HTMLElement>('.site-header');

  burger?.addEventListener('click', () => {
    const open = header?.classList.toggle('site-header--open') ?? false;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute(
      'aria-label',
      (open ? burger.dataset.closeLabel : burger.dataset.openLabel) ?? ''
    );
  });

  // Solidify the bar once the page scrolls away from the hero
  const onScroll = () => header?.classList.toggle('site-header--stuck', window.scrollY > 20);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--canvas) 72%, transparent);
    border-bottom: 1px solid transparent;
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .site-header--stuck {
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  .header__row {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 76px;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
    text-decoration: none;
    color: var(--fg);
    margin-right: auto;
  }
  .mark__text {
    display: flex;
    flex-direction: column;
  }

  .mark__name {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: 0.02em;
    font-size: 1.1rem;
  }

  .mark__sub {
    /* 11px floor: below this, tracked caps stop being legible as functional
       text. Tracking eased slightly so the lockup width barely moves. */
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-mute);
    margin-top: 5px;
  }

  .nav {
    display: flex;
    gap: var(--space-4);
  }

  .nav__link {
    color: var(--fg-mute);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 550;
    padding: 0.3em 0;
    border-bottom: 1.5px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .nav__link:hover {
    color: var(--fg);
  }

  .nav__link--active {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .header__end {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .langs {
    display: flex;
    gap: 2px;
  }

  .langs__item {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--fg-mute);
    text-decoration: none;
    padding: 0.35em 0.55em;
    border-radius: 999px;
  }

  a.langs__item:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 8%, transparent);
  }

  .langs__item--active {
    background: color-mix(in srgb, var(--fg) 12%, transparent);
    color: var(--fg);
  }

  .header__cta {
    font-size: 0.88rem;
    padding: 0.7em 1.2em;
  }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0 9px;
    background: transparent;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }

  .burger span {
    display: block;
    height: 1.5px;
    background: var(--fg);
    transition: transform var(--dur) var(--ease);
  }

  @media (max-width: 920px) {
    .header__row {
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .burger {
      display: flex;
    }

    .header__cta {
      display: none;
    }

    .nav {
      display: none;
      order: 3;
      width: 100%;
      flex-direction: column;
      gap: 0;
      padding-bottom: var(--space-3);
    }

    .site-header--open .nav {
      display: flex;
    }

    .nav__link {
      padding: 0.75em 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.05rem;
    }

    .nav__link--active {
      border-bottom-color: var(--accent);
    }
  }
</style>
