---
import { studio, type Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  /**
   * Lift it clear of the chat assistant, which occupies the same corner. The
   * assistant only exists when PUBLIC_CHAT_ENDPOINT is set, so the offset has
   * to be decided by the layout, not guessed here.
   */
  raised?: boolean;
}

const { locale, raised = false } = Astro.props as Props;
const w = t(locale).whatsapp;

/* wa.me wants digits only. The prefill is a question from the visitor, never a
   promise from us — the same rule the assistant's prompt follows. */
const href = `https://wa.me/${studio.whatsapp.digits}?text=${encodeURIComponent(w.prefill)}`;
---

<a
  class:list={['wa', { 'wa--raised': raised }]}
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={w.aria}
>
  <svg class="wa__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.24-8.23a8.18 8.18 0 0 1 5.82 2.42 8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.21-8.24 8.21Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.74 2.66 4.22 3.73.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.15-1.18-.06-.11-.23-.17-.48-.29Z"
    ></path>
  </svg>
  <span class="wa__label">{w.label}</span>
</a>

<style>
  .wa {
    position: fixed;
    /* Right corner: page content is left-aligned, so the right side is the
       emptier one — bottom-left overlapped the contact page's email link.
       When the assistant is on it takes this corner and .wa--raised stacks
       above it. */
    right: clamp(0.75rem, 3vw, 1.5rem);
    bottom: clamp(0.75rem, 3vw, 1.5rem);
    z-index: 69;

    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    /* Comfortably past the WCAG 2.2 24px target floor. */
    min-height: 48px;
    padding: 0 1.05rem 0 0.9rem;
    border-radius: 999px;

    /* WhatsApp green is the recognisable cue; near-black text clears 4.5:1 on
       it, where white would not. Same rule as --on-accent. */
    background: #25d366;
    color: #0b0a0c;
    border: 1px solid rgba(0, 0, 0, 0.14);
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.55);

    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    text-decoration: none;

    transition:
      transform 200ms var(--ease),
      box-shadow 200ms var(--ease),
      background-color 200ms var(--ease);
  }

  .wa--raised {
    /* Clears the assistant's launcher when both are on screen. */
    bottom: calc(clamp(0.75rem, 3vw, 1.5rem) + 4.25rem);
  }

  .wa:hover {
    background: #1fbe5a;
    transform: translateY(-2px);
    box-shadow: 0 16px 34px -14px rgba(0, 0, 0, 0.6);
  }

  .wa:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .wa__icon {
    width: 22px;
    height: 22px;
    flex: none;
  }

  /* Below 520px the label is dropped: a round icon keeps the thumb zone clear. */
  @media (max-width: 520px) {
    .wa {
      padding: 0;
      width: 52px;
      min-height: 52px;
      justify-content: center;
    }

    .wa__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa {
      transition: none;
    }

    .wa:hover {
      transform: none;
    }
  }
</style>
