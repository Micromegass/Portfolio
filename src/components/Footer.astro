---
import { href, type Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const f = t(locale).footer;
const c = t(locale).contact;
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__who">
      <p class="footer__name">Axel Braunschweiger</p>
      <p class="footer__role">{f.role}</p>
      <p class="footer__meta">{f.locations}</p>
    </div>

    <div class="footer__col">
      <p class="footer__label">{f.contactLabel}</p>
      <a href={`mailto:${c.email}`}>{c.email}</a>
      <p class="footer__meta">
        <a href="https://github.com/Micromegass" rel="me noopener" target="_blank">GitHub</a>
        {' · '}
        <a
          href="https://www.linkedin.com/in/axel-braunschweiger-17b5609b/"
          rel="me noopener"
          target="_blank">LinkedIn</a
        >
      </p>
    </div>

    <div class="footer__col">
      <p class="footer__label">{f.languagesLabel}</p>
      <p class="footer__meta">{f.languages}</p>
      <p class="footer__meta footer__legal">
        <a href={href('imprint', locale)}>{f.legalImprint}</a>
        {' · '}
        <a href={href('privacy', locale)}>{f.legalPrivacy}</a>
      </p>
    </div>
  </div>

  <p class="wrap footer__colophon">{f.colophon}</p>
</footer>

<style>
  .footer {
    margin-top: var(--space-8);
    border-top: 1.5px solid var(--line);
    padding: var(--space-6) 0 var(--space-5);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-5);
  }

  .footer__name {
    font-family: var(--font-display);
    font-variation-settings: var(--display-settings);
    font-weight: 600;
    font-size: var(--text-md);
    margin: 0 0 var(--space-1);
  }

  .footer__role {
    color: var(--text-soft);
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
  }

  .footer__label {
    font-weight: 700;
    font-size: var(--text-sm);
    margin: 0 0 var(--space-2);
  }

  .footer__meta {
    color: var(--text-soft);
    font-size: var(--text-sm);
    margin: var(--space-1) 0 0;
  }

  .footer__legal {
    margin-top: var(--space-3);
  }

  .footer__colophon {
    margin-top: var(--space-5);
    color: var(--text-faint);
    font-size: var(--text-sm);
    max-width: none;
  }

  @media (max-width: 720px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
