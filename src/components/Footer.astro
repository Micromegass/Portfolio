---
import { href, studio, servicePages, type Locale } from '@/lib/i18n';
import { t } from '@/data';
import Logo from '@/components/Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
---

<footer class="site-footer" data-tone="contrast">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <span class="footer__mark">
        <Logo size={26} />
        <span class="mark__name">{studio.name}</span>
      </span>
      <p class="footer__blurb">{c.footer.blurb}</p>
      <p class="footer__loc">{c.footer.locations}</p>
    </div>

    <nav class="footer__col" aria-label={c.footer.servicesLabel}>
      <h2 class="footer__head">{c.footer.servicesLabel}</h2>
      {servicePages.map((key) => <a href={href(key, locale)}>{c.services[key].navLabel}</a>)}
    </nav>

    <nav class="footer__col" aria-label={c.footer.studioLabel}>
      <h2 class="footer__head">{c.footer.studioLabel}</h2>
      <a href={href('work', locale)}>{c.work.eyebrow}</a>
      <a href={href('pricing', locale)}>{c.pricing.eyebrow}</a>
      <a href={href('about', locale)}>{c.about.eyebrow}</a>
      <a href={href('imprint', locale)}>{c.footer.legalImprint}</a>
      <a href={href('privacy', locale)}>{c.footer.legalPrivacy}</a>
    </nav>

    <div class="footer__col">
      <h2 class="footer__head">{c.footer.contactLabel}</h2>
      <a href={`mailto:${studio.email}`}>{studio.email}</a>
      <a
        href={`https://wa.me/${studio.whatsapp.digits}?text=${encodeURIComponent(c.whatsapp.prefill)}`}
        rel="noopener"
        target="_blank">{`${c.whatsapp.label} · ${studio.whatsapp.display}`}</a
      >
      <a href="https://github.com/Micromegass" rel="me noopener" target="_blank">GitHub</a>
      <a
        href="https://www.linkedin.com/in/axel-braunschweiger-17b5609b/"
        rel="me noopener"
        target="_blank">LinkedIn</a
      >
    </div>
  </div>

  <div class="wrap footer__base">
    <p>© {new Date().getFullYear()} {studio.name} · {studio.person}</p>
    <p>{c.footer.colophon}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    color: var(--fg);
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: var(--space-5);
  }

  .footer__mark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .mark__name {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: 0.02em;
    font-size: 1.1rem;
  }

  .footer__blurb {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    margin: var(--space-3) 0 var(--space-2);
    max-width: 26rem;
  }

  .footer__loc {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    margin: 0;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__head {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-mute);
    margin: 0 0 var(--space-1);
  }

  .footer__col a {
    color: var(--fg);
    text-decoration: none;
    font-size: var(--text-sm);
    /* WCAG 2.2 target size: keep every touch target at least 24px tall */
    min-height: 24px;
    display: flex;
    align-items: center;
  }

  .footer__col a:hover {
    color: var(--accent);
  }

  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .footer__base p {
    margin: 0;
    color: var(--fg-mute);
    font-size: var(--text-xs);
    max-width: none;
  }

  @media (max-width: 820px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  /* Two columns cannot hold long German and Spanish labels on a 320px screen —
     they push the grid wider than the viewport. */
  @media (max-width: 420px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__col a {
      overflow-wrap: anywhere;
    }
  }
</style>
