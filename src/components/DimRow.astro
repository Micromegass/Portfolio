---
/**
 * A row of "measurements" — values presented as dimension lines
 * with end ticks, like widths annotated on a technical drawing.
 */
interface Props {
  dims: { value: string; label: string }[];
}

const { dims } = Astro.props;
---

<dl class="dims" data-reveal-group>
  {
    dims.map(({ value, label }) => (
      <div class="dim">
        <dt class="anno dim__label">{label}</dt>
        <dd class="dim__value">{value}</dd>
        <svg class="dim__line" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" data-draw>
          <line x1="1" y1="1" x2="1" y2="9" />
          <line x1="1" y1="5" x2="99" y2="5" />
          <line x1="99" y1="1" x2="99" y2="9" />
        </svg>
      </div>
    ))
  }
</dl>

<style>
  .dims {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin: 0;
  }

  .dim {
    display: flex;
    flex-direction: column;
    min-width: 9rem;
  }

  .dim__value {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 125, 'wght' 700;
    font-size: var(--text-lg);
    margin: 0;
    order: 1;
    line-height: 1;
  }

  .dim__label {
    order: 3;
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }

  .dim__line {
    order: 2;
    width: 100%;
    height: 10px;
    margin-top: var(--space-2);
    overflow: visible;
  }

  .dim__line line {
    stroke: var(--mark);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
</style>
