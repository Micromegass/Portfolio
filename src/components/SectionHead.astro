---
interface Props {
  kicker: string;
  title: string;
  centered?: boolean;
}

const { kicker, title, centered = false } = Astro.props;
---

<div class:list={['section-head', { 'section-head--centered': centered }]} data-reveal>
  <span class="eyebrow">{kicker}</span>
  <h2>{title}</h2>
</div>

<style>
  .section-head {
    margin-bottom: var(--space-5);
  }

  .section-head h2 {
    margin: var(--space-2) 0 0;
    max-width: 24ch;
  }

  .section-head--centered {
    text-align: center;
  }

  .section-head--centered h2 {
    margin-inline: auto;
  }
</style>
