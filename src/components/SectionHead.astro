---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  centered?: boolean;
}

const { eyebrow, title, intro, centered = false } = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': centered }]} data-reveal>
  <span class="eyebrow">{eyebrow}</span>
  <h2>{title}</h2>
  {intro && <p class="lead">{intro}</p>}
</div>

<style>
  .section-head {
    max-width: 44rem;
    margin-bottom: var(--space-6);
  }

  .section-head h2 {
    margin: 0 0 var(--space-3);
  }

  .section-head--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-head--center .lead {
    margin-inline: auto;
  }
</style>
