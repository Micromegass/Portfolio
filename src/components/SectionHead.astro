---
interface Props {
  kicker: string;
  title: string;
  /** Figure number rendered like a drawing label, e.g. "02" */
  fig?: string;
}

const { kicker, title, fig } = Astro.props;
---

<div class="section-head" data-reveal>
  <div class="section-head__meta">
    <span class="anno anno--mark">{fig && `FIG. ${fig} — `}{kicker}</span>
    <hr class="rule section-head__rule" aria-hidden="true" />
  </div>
  <h2>{title}</h2>
</div>

<style>
  .section-head {
    margin-bottom: var(--space-5);
  }

  .section-head__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .section-head__rule {
    flex: 1;
  }

  h2 {
    margin-bottom: 0;
    max-width: 22ch;
  }
</style>
