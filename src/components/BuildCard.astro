---
import { Image } from 'astro:assets';
import { buildImages } from '@/data/buildImages';
import type { SiteContent } from '@/data/types';
import type { Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  build: SiteContent['work']['builds'][number];
  /** Heading level, so the card slots into the page outline without a jump */
  as?: 'h2' | 'h3';
}

const { locale, build, as: Heading = 'h3' } = Astro.props as Props;
const w = t(locale).work;
const shot = buildImages[build.key];
---

<article class="build card">
  <div class="build__shot">
    <!-- Two-up above 700px, full width below. `widths` (not `densities`): with
         x-descriptors `sizes` is inert, so a 2x phone would still pull the
         desktop candidate. -->
    <Image
      src={shot}
      alt={build.imageAlt}
      widths={[320, 480, 620, 900, 1240]}
      sizes="(min-width: 1200px) 560px, (min-width: 700px) 46vw, 92vw"
      loading="lazy"
    />
  </div>
  <div class="build__body">
    <span class="eyebrow">{build.sector}</span>
    <Heading class="build__title">{build.client}</Heading>
    <p class="build__desc">{build.desc}</p>
    <div class="build__foot">
      <span class="build__status">
        <span class="dot" aria-hidden="true"></span>
        {build.status}
      </span>
      {
        build.preview && (
          <a class="arrow-link build__link" href={build.preview.url} target="_blank" rel="noopener">
            {build.preview.label} <span aria-hidden="true">→</span>
            <span class="sr-only">
              ({build.client}, {w.newTab})
            </span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .build {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .build__shot {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .build__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .build__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .build__title {
    font-size: var(--text-md);
    margin: 0;
  }

  .build__desc {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin: 0;
  }

  .build__foot {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .build__status {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-mute);
    /* WCAG 2.2 target size — keep the row at least 24px tall */
    min-height: 24px;
  }

  .build__link {
    font-size: var(--text-sm);
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 24px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
</style>
