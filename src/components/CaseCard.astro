---
import { href, type Locale, type PageKey } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  caseKey: 'physio' | 'ikuna';
}

const { locale, caseKey } = Astro.props;
const c = t(locale).cases[caseKey];
const w = t(locale).work;
const page: PageKey = caseKey === 'physio' ? 'case-physio' : 'case-ikuna';
---

<article class:list={['case card card--hover', `case--${caseKey}`]}>
  <a class="case__link" href={href(page, locale)}>
    <div class="case__shot" aria-hidden="true">
      <span class="case__url">{c.urlLabel}</span>
    </div>
    <div class="case__body">
      <span class="eyebrow">{c.sector}</span>
      <h3 class="case__title">{c.cardTitle}</h3>
      <p class="case__desc">{c.cardDesc}</p>
      <dl class="case__metrics">
        {
          c.metrics.map((m) => (
            <div>
              <dt class="case__metric-label">{m.label}</dt>
              <dd class="case__metric-value">{m.value}</dd>
            </div>
          ))
        }
      </dl>
      <span class="arrow-link case__cta">{w.readLabel} <span>→</span></span>
    </div>
  </a>
</article>

<style>
  .case {
    overflow: hidden;
  }

  .case__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .case__shot {
    height: 200px;
    position: relative;
    background: linear-gradient(135deg, #2b2431, #4a3c4f);
  }

  .case--ikuna .case__shot {
    background: linear-gradient(135deg, #1f3a34, #3f6f5c);
  }

  .case__url {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    padding: 0.4em 0.85em;
    border-radius: 999px;
  }

  .case__body {
    padding: var(--space-4) var(--space-4) var(--space-5);
  }

  .case__title {
    margin: 0 0 var(--space-2);
  }

  .case__desc {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin: 0;
  }

  .case__metrics {
    display: flex;
    gap: var(--space-5);
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .case__metric-value {
    font-family: var(--font-display);
    font-weight: 780;
    letter-spacing: -0.03em;
    font-size: 1.3rem;
    margin: 0;
  }

  .case__metric-label {
    font-size: var(--text-xs);
    color: var(--fg-mute);
    order: 2;
  }

  .case__metrics div {
    display: flex;
    flex-direction: column;
  }

  .case__cta {
    margin-top: var(--space-4);
  }
</style>
