---
import { Image } from 'astro:assets';
import { href, type Locale, type PageKey } from '@/lib/i18n';
import { t } from '@/data';
import { caseImages } from '@/data/caseImages';

interface Props {
  locale: Locale;
  caseKey: 'physio' | 'ikuna';
  /** Heading level, so the card slots into each page's outline without a jump */
  as?: 'h2' | 'h3';
}

const { locale, caseKey, as: Heading = 'h3' } = Astro.props as Props;
const c = t(locale).cases[caseKey];
const w = t(locale).work;
const page: PageKey = caseKey === 'physio' ? 'case-physio' : 'case-ikuna';
const shot = caseImages[caseKey];
---

<article class:list={['case card card--hover', `case--${caseKey}`]}>
  <a class="case__link" href={href(page, locale)}>
    <div class="case__shot">
      <!-- `widths` + `sizes`, not `densities`: with x-descriptors `sizes` is
           ignored and a 2x phone pulls the full desktop candidate. -->
      <Image
        src={shot}
        alt={c.imageAlt}
        widths={[380, 560, 760, 1100, 1520]}
        sizes="(min-width: 1200px) 560px, (min-width: 700px) 46vw, 92vw"
        loading="lazy"
      />
      <span class="case__live"><span class="case__live-dot" aria-hidden="true"></span>{w.liveBadge}</span>
      <span class="case__url">{c.urlLabel}</span>
    </div>
    <div class="case__body">
      <span class="eyebrow">{c.sector}</span>
      <Heading class="case__title">{c.cardTitle}</Heading>
      <p class="case__desc">{c.cardDesc}</p>
      <dl class="case__metrics">
        {
          c.metrics.map((m) => (
            <div>
              <dt class="case__metric-label">{m.label}</dt>
              <dd class="case__metric-value">{m.value}</dd>
            </div>
          ))
        }
      </dl>
      <span class="arrow-link case__cta">{w.readLabel} <span>→</span></span>
    </div>
  </a>
</article>

<style>
  .case {
    overflow: hidden;
  }

  .case__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .case__shot {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
  }

  .case__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .case:hover .case__shot :global(img) {
    transform: scale(1.03);
  }

  .case__url {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    padding: 0.4em 0.85em;
    border-radius: 999px;
  }

  /* Marks the site as live client work — the pulse is the same claim as the
     builds' status dot, so the two card families read as one system. */
  .case__live {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    padding: 0.4em 0.85em;
    border-radius: 999px;
  }

  .case__live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    flex: none;
  }

  .case__body {
    padding: var(--space-4) var(--space-4) var(--space-5);
  }

  .case__title {
    /* Fixed size regardless of heading level: at h2 scale the two cards
       shouted over the rest of the Work page. */
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }

  .case__desc {
    color: var(--fg-mute);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin: 0;
  }

  .case__metrics {
    display: flex;
    gap: var(--space-5);
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .case__metric-value {
    font-family: var(--font-display);
    font-weight: 780;
    letter-spacing: -0.03em;
    font-size: 1.3rem;
    margin: 0;
  }

  .case__metric-label {
    font-size: var(--text-xs);
    color: var(--fg-mute);
    order: 2;
  }

  .case__metrics div {
    display: flex;
    flex-direction: column;
  }

  .case__cta {
    margin-top: var(--space-4);
  }
</style>
