---
import { href, type Locale, type PageKey } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  caseKey: 'physio' | 'ikuna';
}

const { locale, caseKey } = Astro.props;
const c = t(locale).cases[caseKey];
const w = t(locale).work;
const page: PageKey = caseKey === 'physio' ? 'case-physio' : 'case-ikuna';
---

<article class="case-card">
  <span class="case-card__url">{c.urlLabel}</span>
  <h3 class="case-card__title">
    <a href={href(page, locale)}>{c.title}</a>
  </h3>
  <p class="case-card__client">{c.client}</p>
  <p class="case-card__summary">{c.summary}</p>
  <p class="case-card__link">
    <a href={href(page, locale)}>{w.readLabel} →</a>
  </p>
</article>

<style>
  .case-card {
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform var(--dur-quick) var(--ease-calm);
  }

  .case-card:hover {
    transform: translateY(-3px);
  }

  .case-card__url {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--green-dark);
    background: color-mix(in srgb, var(--green) 10%, transparent);
    border-radius: 999px;
    padding: 0.35em 0.9em;
    margin-bottom: var(--space-2);
  }

  .case-card__title {
    margin: 0;
    font-size: var(--text-lg);
  }

  .case-card__title a {
    color: var(--text);
    text-decoration: none;
  }

  .case-card__title a:hover {
    color: var(--green-dark);
  }

  .case-card__client {
    color: var(--text-faint);
    font-size: var(--text-sm);
    font-weight: 600;
    margin: 0;
  }

  .case-card__summary {
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  .case-card__link {
    margin: var(--space-2) 0 0;
    font-weight: 600;
  }
</style>
