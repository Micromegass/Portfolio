---
import { href, type Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
const k = c.check;
const checkHref = href('check', locale);
---

<!-- Immediate action on arrival: type an address, land on the results page
     with the analysis already running. -->
<form class="hero-check" id="hero-check" action={checkHref} method="get" data-target={checkHref}>
  <label class="sr-only" for="hero-check-url">{k.inputLabel}</label>

  <div class="hero-check__field">
    <svg class="hero-check__globe" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path>
    </svg>
    <input
      class="hero-check__input"
      id="hero-check-url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="url"
      spellcheck="false"
      placeholder={k.placeholder}
      aria-describedby="hero-check-note"
      required
    />
    <button class="hero-check__go" type="submit">
      <span class="hero-check__go-text">{k.submit}</span>
      <span class="hero-check__go-icon" aria-hidden="true">→</span>
    </button>
  </div>

  <p class="hero-check__note" id="hero-check-note">{c.home.checkNote}</p>
  <p class="hero-check__error" id="hero-check-error" role="alert"></p>
</form>

<script is:inline define:vars={{ checkStrings: k }}>
  // The hero needs the same error copy as the check page
  window.__CHECK_STRINGS__ = checkStrings;
</script>

<script>
  import { normaliseUrl } from '@/scripts/websiteCheck';

  const form = document.getElementById('hero-check') as HTMLFormElement | null;
  const input = document.getElementById('hero-check-url') as HTMLInputElement | null;
  const error = document.getElementById('hero-check-error');
  const strings = (window as any).__CHECK_STRINGS__;

  form?.addEventListener('submit', (e) => {
    if (!input || !error) return;
    e.preventDefault();

    const url = normaliseUrl(input.value);
    if (!url) {
      error.textContent = strings?.errors?.invalid ?? '';
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return;
    }

    error.textContent = '';
    input.removeAttribute('aria-invalid');
    const target = form.dataset.target ?? '/';
    window.location.href = `${target}?url=${encodeURIComponent(url)}`;
  });

  // Clear the error as soon as the visitor starts fixing it
  input?.addEventListener('input', () => {
    if (error?.textContent) {
      error.textContent = '';
      input.removeAttribute('aria-invalid');
    }
  });
</script>

<style>
  .hero-check {
    margin-top: var(--space-5);
    max-width: 34rem;
  }

  /* One pill containing the input and its button */
  .hero-check__field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: color-mix(in srgb, var(--fg) 6%, transparent);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    padding: 5px 5px 5px var(--space-4);
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .hero-check__field:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .hero-check__globe {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--fg-mute);
    stroke-width: 1.6;
  }

  .hero-check__input {
    flex: 1 1 auto;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--fg);
    padding: 0.7em 0;
  }

  .hero-check__input::placeholder {
    color: var(--fg-mute);
  }

  .hero-check__go {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    border-radius: 999px;
    padding: 0.75em 1.3em;
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }

  .hero-check__go:hover {
    background: var(--accent-hot);
  }

  .hero-check__go-icon {
    transition: transform var(--dur) var(--ease);
  }

  .hero-check__go:hover .hero-check__go-icon {
    transform: translateX(3px);
  }

  .hero-check__note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--fg-mute);
  }

  .hero-check__error {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--status-bad);
    min-height: 0;
  }

  .hero-check__error:empty {
    margin: 0;
  }

  @media (max-width: 560px) {
    .hero-check__field {
      flex-wrap: wrap;
      border-radius: var(--radius-lg);
      padding: var(--space-3);
    }

    .hero-check__globe {
      display: none;
    }

    .hero-check__input {
      flex-basis: 100%;
      padding: 0.4em 0.2em 0.6em;
    }

    .hero-check__go {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
