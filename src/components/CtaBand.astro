---
import { href, type Locale } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const cta = t(locale).cta;
---

<section class="cta wrap" data-reveal>
  <div class="cta__box">
    <span class="cta__kicker">{cta.kicker}</span>
    <h2 class="cta__title">{cta.title}</h2>
    <p class="cta__body">{cta.body}</p>
    <a class="cta__button" href={href('contact', locale)}>{cta.button} →</a>
  </div>
</section>

<style>
  .cta {
    margin-top: var(--space-8);
  }

  .cta__box {
    background: var(--green-deep);
    color: var(--cream-on-deep);
    border-radius: var(--radius-lg);
    padding: var(--space-7) var(--space-5);
    text-align: center;
  }

  .cta__kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber-soft);
  }

  .cta__title {
    color: #fff;
    margin: var(--space-3) auto var(--space-3);
    max-width: 20ch;
  }

  .cta__body {
    color: var(--cream-on-deep);
    margin-inline: auto;
    max-width: 34rem;
  }

  .cta__button {
    display: inline-block;
    margin-top: var(--space-4);
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
    background: #fff;
    border-radius: 999px;
    padding: 0.8em 1.8em;
    transition:
      background var(--dur-quick) var(--ease-calm),
      transform var(--dur-quick) var(--ease-calm);
  }

  .cta__button:hover {
    background: var(--bg-soft);
    transform: translateY(-2px);
    color: var(--text);
  }
</style>
