---
/**
 * The signature element: the chronological path.
 * Chapters alternate left/right along a gently curving dotted trail
 * that draws itself in as you scroll (see motion.ts, data-draw).
 */
interface Props {
  chapters: { period: string; title: string; body: string }[];
}

const { chapters } = Astro.props;
---

<ol class="path">
  <svg class="path__trail" viewBox="0 0 60 1000" preserveAspectRatio="none" aria-hidden="true" data-draw>
    <defs>
      <mask id="trail-mask" maskUnits="userSpaceOnUse">
        <path
          data-draw-stroke
          d="M 30 0
             C 55 125, 5 125, 30 250
             C 55 375, 5 375, 30 500
             C 55 625, 5 625, 30 750
             C 55 875, 5 875, 30 1000"
          fill="none"
          stroke="#fff"
          stroke-width="8"
        />
      </mask>
    </defs>
    <path
      class="path__trail-line"
      mask="url(#trail-mask)"
      d="M 30 0
         C 55 125, 5 125, 30 250
         C 55 375, 5 375, 30 500
         C 55 625, 5 625, 30 750
         C 55 875, 5 875, 30 1000"
      fill="none"
    />
  </svg>

  {
    chapters.map((ch, i) => (
      <li class:list={['stop', i % 2 ? 'stop--right' : 'stop--left']} data-reveal>
        <div class="stop__marker" aria-hidden="true">{i + 1}</div>
        <div class="stop__card">
          <span class="eyebrow">{ch.period}</span>
          <h3 class="stop__title">{ch.title}</h3>
          <p class="stop__body">{ch.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .path {
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .path__trail {
    position: absolute;
    inset: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 100%;
  }

  .path__trail-line {
    stroke: var(--amber-soft);
    stroke-width: 2.5;
    stroke-dasharray: 1 9;
    stroke-linecap: round;
  }

  /* No JS (html.js absent): show the full trail, no draw effect */
  :global(html:not(.js)) .path__trail mask path {
    stroke-dasharray: none !important;
    stroke-dashoffset: 0 !important;
  }

  .stop {
    position: relative;
    display: flex;
    width: 100%;
  }

  .stop--left { justify-content: flex-start; }
  .stop--right { justify-content: flex-end; }

  .stop__card {
    width: min(44%, 30rem);
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-4);
    box-shadow: var(--shadow-soft);
  }

  .stop__marker {
    position: absolute;
    left: 50%;
    top: var(--space-4);
    transform: translateX(-50%);
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    font-weight: 700;
    display: grid;
    place-items: center;
    border: 4px solid var(--bg);
  }

  .stop__title {
    font-size: var(--text-md);
    margin: var(--space-1) 0 var(--space-2);
  }

  .stop__body {
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 760px) {
    .path__trail {
      left: 1.2rem;
      transform: none;
    }

    .stop {
      justify-content: flex-start;
      padding-left: 3.4rem;
    }

    .stop__marker {
      left: 1.2rem;
    }

    .stop__card {
      width: 100%;
    }
  }
</style>
