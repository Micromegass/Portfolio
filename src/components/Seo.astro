---
import { alternates, ogLocale, studio, type Locale, type PageKey } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const meta = t(locale).meta[page];
const site = Astro.site!.toString().replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = site + base + (Astro.url.pathname.replace(base, '') || '/');

// The interim GitHub Pages deploy must never be indexed
const noindex = import.meta.env.GITHUB_PAGES === 'true';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': site + base + '/#studio',
  name: studio.name,
  description: t(locale).footer.blurb,
  url: site + base + '/',
  founder: { '@type': 'Person', name: studio.person },
  email: studio.email,
  areaServed: ['DE', 'AT', 'CH', 'CO', 'Remote'],
  availableLanguage: ['German', 'English', 'Spanish'],
  knowsAbout: [
    'Website relaunch',
    'Website modernisation',
    'AI chat assistants',
    'Web application development',
    'MVP development',
  ],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Fürth', addressCountry: 'DE' },
    { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
  ],
};

const c = t(locale);
const serviceKey = page === 'relaunch' || page === 'ai' || page === 'apps' ? page : null;

const serviceJsonLd = serviceKey && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: c.services[serviceKey].cardTitle,
  description: meta.description,
  provider: { '@type': 'ProfessionalService', name: studio.name },
  areaServed: ['DE', 'CO', 'Remote'],
};

const faqJsonLd = serviceKey && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.services[serviceKey].faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const blocks = [
  page === 'home' || page === 'about' ? orgJsonLd : null,
  serviceJsonLd,
  faqJsonLd,
].filter(Boolean);
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  alternates(page).map(({ locale: l, path }) => (
    <link rel="alternate" hreflang={l} href={site + base + path} />
  ))
}
<link rel="alternate" hreflang="x-default" href={site + base + alternates(page)[0].path} />

<meta property="og:type" content="website" />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[locale]} />
<meta property="og:site_name" content={studio.name} />
<meta name="twitter:card" content="summary" />
<meta name="theme-color" content="#0b0a0c" />

{blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
