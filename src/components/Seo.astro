---
import { alternates, ogLocale, routes, studio, type Locale, type PageKey } from '@/lib/i18n';
import { t } from '@/data';

interface Props {
  locale: Locale;
  page: PageKey;
  /**
   * The 404 borrows the home page key for its layout, but it is not the home
   * page: without this it duplicates the home title, description, canonical,
   * hreflang and schema, and invites indexing of an error page.
   */
  errorPage?: boolean;
}

const { locale, page, errorPage = false } = Astro.props;
const meta = t(locale).meta[page];
const site = Astro.site!.toString().replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = site + base + (Astro.url.pathname.replace(base, '') || '/');

// The interim GitHub Pages deploy must never be indexed; nor should an error page
const noindex = import.meta.env.GITHUB_PAGES === 'true' || errorPage;

/* Its own identity, so it stops duplicating the home page in search results. */
const errorMeta = {
  title: `${t(locale).notFound.title} | ${studio.name}`,
  description: t(locale).notFound.body,
};

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': site + base + '/#studio',
  name: studio.name,
  description: t(locale).footer.blurb,
  url: site + base + '/',
  // sameAs lets answer engines cross-reference the studio and its founder
  // against profiles they already trust, instead of guessing who we are.
  founder: {
    '@type': 'Person',
    name: studio.person,
    url: site + base + routes.about[locale],
    sameAs: studio.profiles,
  },
  sameAs: studio.profiles,
  email: studio.email,
  areaServed: ['DE', 'AT', 'CH', 'CO', 'Remote'],
  availableLanguage: ['German', 'English', 'Spanish'],
  knowsAbout: [
    'Website relaunch',
    'Website modernisation',
    'AI chat assistants',
    'Web application development',
    'MVP development',
  ],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Fürth', addressCountry: 'DE' },
    { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
  ],
};

const c = t(locale);
const serviceKey = page === 'relaunch' || page === 'ai' || page === 'apps' ? page : null;

const serviceJsonLd = serviceKey && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: c.services[serviceKey].cardTitle,
  description: meta.description,
  provider: { '@type': 'ProfessionalService', name: studio.name },
  areaServed: ['DE', 'CO', 'Remote'],
};

// Any page that actually carries a Q&A list gets FAQ schema: the three service
// pages and the pricing page.
const faqSource = serviceKey
  ? c.services[serviceKey].faq
  : page === 'pricing'
    ? c.pricing.faq
    : null;

const faqJsonLd = faqSource && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSource.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/**
 * Published prices, as machine-readable offers. The displayed price is a
 * localized string ("€1,200", "1.200 €"), so the digits are extracted rather
 * than duplicated — a tier without a published price (`null`) contributes no
 * offer at all, which is exactly the claim we want to make.
 */
const offerJsonLd = page === 'pricing' && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: c.meta.pricing.title.split(/[—|]/)[0].trim(),
  description: meta.description,
  provider: { '@id': site + base + '/#studio' },
  areaServed: ['DE', 'CO', 'Remote'],
  offers: [...c.pricing.tiers, ...c.pricing.care]
    .filter((o) => o.price !== null)
    .map((o) => ({
      '@type': 'Offer',
      name: o.name,
      description: o.desc,
      priceCurrency: 'EUR',
      price: Number(o.price!.replace(/\D/g, '')),
      url: canonical,
    })),
};

// Social preview card, localized
const ogImage = `${site}${base}/og${locale === 'en' ? '' : `-${locale}`}.png`;

/** Build timestamp — a truthful "last modified" for freshness signals. */
const buildDate = new Date().toISOString().slice(0, 10);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': site + base + '/#website',
  name: studio.name,
  url: site + base + '/',
  inLanguage: locale,
  publisher: { '@id': site + base + '/#studio' },
  dateModified: buildDate,
};

// Breadcrumbs help Google render the path in results and give LLMs hierarchy
const trail: { name: string; page: PageKey }[] = [{ name: studio.name, page: 'home' }];
if (page === 'case-physio' || page === 'case-ikuna') trail.push({ name: c.work.eyebrow, page: 'work' });
if (page !== 'home') trail.push({ name: c.meta[page].title.split(/[—|]/)[0].trim(), page });

const breadcrumbJsonLd = page !== 'home' && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    item: site + base + routes[t.page][locale],
  })),
};

// Case studies: describe the project as a work the studio created, so search
// engines and answer engines can attribute it correctly.
const caseKey = page === 'case-physio' ? 'physio' : page === 'case-ikuna' ? 'ikuna' : null;
const caseJsonLd = caseKey && {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: c.cases[caseKey].title,
  headline: c.cases[caseKey].title,
  description: meta.description,
  inLanguage: locale,
  url: canonical,
  image: ogImage,
  creator: { '@id': site + base + '/#studio' },
  author: { '@id': site + base + '/#studio' },
  // Honest freshness signal: when this page was last built. No datePublished —
  // the real launch dates are not recorded, and guessing them would be a lie.
  dateModified: buildDate,
  about: {
    '@type': 'Organization',
    name: c.cases[caseKey].client,
    url: c.cases[caseKey].url,
  },
  keywords: c.cases[caseKey].specs.map((s) => s.value).join(', '),
};

// An error page describes nothing, so it carries no structured data at all.
const blocks = errorPage
  ? []
  : [
      page === 'home' || page === 'about' ? orgJsonLd : null,
      page === 'home' ? websiteJsonLd : null,
      breadcrumbJsonLd,
      serviceJsonLd,
      faqJsonLd,
      offerJsonLd,
      caseJsonLd,
    ].filter(Boolean);
---

<title>{errorPage ? errorMeta.title : meta.title}</title>
<meta name="description" content={errorPage ? errorMeta.description : meta.description} />
{/* An error page is not a canonical URL and has no language alternates. */}
{!errorPage && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  !errorPage &&
    alternates(page).map(({ locale: l, path }) => (
      <link rel="alternate" hreflang={l} href={site + base + path} />
    ))
}
{
  !errorPage && (
    <link rel="alternate" hreflang="x-default" href={site + base + alternates(page)[0].path} />
  )
}

<meta property="og:type" content="website" />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[locale]} />
<meta property="og:site_name" content={studio.name} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${studio.name} — ${studio.tagline[locale]}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" content="#0b0a0c" />

{blocks.map((b) => <script is:inline type="application/ld+json" set:html={JSON.stringify(b)} />)}
