# Optional: raises the free quota for the website-check tool.
# Create at https://console.cloud.google.com → enable "PageSpeed Insights API".
# This key is public by design — restrict it by HTTP referrer in the console.
PUBLIC_PSI_KEY=

# The studio assistant's backend (see backend/ — a Cloudflare Worker).
# Leave empty and the chat widget is left out of the build entirely.
# Example: https://renovo-assistant.<subdomain>.workers.dev
PUBLIC_CHAT_ENDPOINT=
